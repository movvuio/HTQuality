# Contact form email (Resend)
# Sign up at https://resend.com → API Keys → create key
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives form submissions (your personal email)
CONTACT_TO_EMAIL=you@example.com

# Sender address shown in the email
# Before domain verification (testing):
CONTACT_FROM_EMAIL=HT Quality <onboarding@resend.dev>
# After verifying htqmexico.com in Resend:
# CONTACT_FROM_EMAIL=HT Quality <contacto@htqmexico.com>

# Site URL for SEO metadata (optional)
NEXT_PUBLIC_SITE_URL=https://www.htqmexico.com

# --- Vercel setup ---
# 1. Project → Settings → Environment Variables → add the three vars above
# 2. Enable for Production, Preview, and Development
# 3. Redeploy the project
#
# Resend free tier: before domain verification, emails can only be sent TO
# your Resend signup email using onboarding@resend.dev as the sender.
# Verify htqmexico.com in Resend to send from contacto@htqmexico.com.
